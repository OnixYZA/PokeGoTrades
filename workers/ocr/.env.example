# The OCR worker's own environment. Copy to .env (git-ignored) for local runs; on AWS Lambda set the same
# names as function environment variables. Never put the service role key in the Expo app's .env files:
# it bypasses RLS, and anything prefixed EXPO_PUBLIC_ is bundled into the app.

# Local stack: `npx supabase status -o env` prints API_URL and SERVICE_ROLE_KEY.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults shown.
# OCR_BATCH_SIZE=10               proofs handled per run
# OCR_DATE_ORDER=MDY              how to read 03/04/2021 when both parts could be a month: MDY or DMY
# OCR_CLAIM_LEASE_SECONDS=600     a proof stuck in 'processing' longer than this is released for a retry
# OCR_IMAGE_TIMEOUT_SECONDS=60    give up on one image after this long
# OCR_LANG_PATH=                  folder containing eng.traineddata.gz (default: ./lang, else the dev dependency)
