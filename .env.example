# Copy to .env.local (git-ignored). Values from `npx supabase status` locally, or the project's API settings when hosted.
# Publishable key only (sb_publishable_...). Never ship sb_secret_..., the service role key, or the database password.
# On a physical device (or a tunnel), localhost/127.0.0.1 resolves on the PHONE, not this machine —
# use your machine's LAN IP instead (e.g. http://192.168.1.23:54321). lib/supabase.ts warns loudly
# in dev if this is still a loopback address on native.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# mock (default when unset) = local Zustand seed data. supabase = feed + listing creation use the database above.
# Restart `expo start` after changing it: Expo inlines EXPO_PUBLIC_* at bundle time.
EXPO_PUBLIC_DATA_SOURCE=mock
