# Copy to supabase/.env (git-ignored) — the Supabase CLI reads *that* file, not the root .env/.env.local.
# Only needed for a local stack (`supabase start`): the hosted project's providers are configured in
# the Dashboard instead. See supabase/config.toml's [auth.external.google] / [auth.external.azure].
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
